  "intros": {
    "mob": {
      "glyph": "\u25cf",
      "title": "MOB",
      "text": "Standard drone. Steady, expendable, endless. WEAK TO CANNON."
    },
    "dart": {
      "glyph": "\u25b2",
      "title": "DART",
      "text": "Fast and fragile \u2014 closes distance quickly. WEAK TO NOVA."
    },
    "brute": {
      "glyph": "\u25a0",
      "title": "BRUTE",
      "text": "Armor absorbs 6 damage from every hit. Slow, heavy. WEAK TO BOMB."
    },
    "splitter": {
      "glyph": "\u2b1f",
      "title": "SPLITTER",
      "text": "Cracks into two darts when destroyed. WEAK TO PIERCE."
    },
    "shield": {
      "glyph": "\u25c8",
      "title": "SHIELD",
      "text": "Carries a barrier that soaks cannon fire. A nova or bomb hit shatters it. WEAK TO NOVA."
    },
    "mender": {
      "glyph": "\u271a",
      "title": "MENDER",
      "text": "Heals every enemy near it. Kill it first or the swarm never thins."
    },
    "bomber": {
      "glyph": "\u2739",
      "title": "BOMBER",
      "text": "Explodes when killed. If it dies close to the keep, the keep takes the blast. Kill it far out. WEAK TO CANNON."
    },
    "phaser": {
      "glyph": "\u25c7",
      "title": "PHASER",
      "text": "Blinks forward every couple of seconds and ignores stasis. WEAK TO BOMB."
    }
